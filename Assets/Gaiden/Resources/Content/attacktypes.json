{
  "Default": "blunt",
  "Types": [
    { "Id": "slash", "Brief": "A blade whoosh ending in a clean cut through cloth or flesh; a short metal ring on armoured targets.",
      "Sfx": ["battle_hit_slash_0", "battle_hit_slash_1", "battle_hit_slash_2", "battle_hit_slash_3"] },
    { "Id": "pierce", "Brief": "A fast thrust: a tight air-hiss and a sharp, wet punch-through; a point skidding on mail when armoured.",
