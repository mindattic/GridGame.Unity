/* GridGame — UI theme. A nod to the 16-bit Square menus, not a copy: Chrono Trigger gray gradient windows
   (the default "Chrono" theme, GG-T385) in light bevelled frames, pointing-hand cursor rows, gold numbers, and
   block-outlined text with a hard drop shadow. Every screen is built in C# from these classes. */

/* -- Design tokens (GG-T250, docs/POLISH.md): the one source for color, type and spacing; App/UI/Tokens.cs
   mirrors the same values for code. Use var(--...) in rules, never a fresh literal. -- */
:root {
    /* Neutrals are gray, not blue (GG-T385), so they sit on the Chrono window; gameplay hues below are unchanged. */
    --color-text: rgb(244, 244, 246);
    /* GG-T495 contrast: dim, bad and the junk/rare/epic rarities clear 4.5:1 on the Classic window's lightest stop (#2C46AA). */
    --color-dim: rgb(200, 200, 208);
    --color-sub: rgb(208, 208, 214);
    --color-white: rgb(255, 255, 255);
    --color-ink: rgb(14, 14, 18);
    --color-frame: rgb(238, 238, 240);
    --color-panel: rgba(44, 44, 48, 0.94);
    /* Text depth (GG-T385): a dark block outline plus a hard, unblurred drop shadow, mobile-RPG style. Three steps
       by size so captions stay legible; applied once by class below, never per screen. */
    --color-text-edge: rgb(8, 8, 12);
    --color-text-drop: rgba(0, 0, 0, 0.85);
    --color-gold: rgb(255, 217, 89);
    --color-good: rgb(115, 242, 148);
    --color-bad: rgb(255, 170, 162);
    --color-warn: rgb(255, 196, 92);
    --color-info: rgb(219, 224, 255);
    --color-mana: rgb(107, 199, 255);
    --color-hero: rgb(120, 171, 255);
    --color-enemy: rgb(235, 69, 74);
    --color-boss: rgb(219, 102, 255);
    --color-guest: rgb(110, 240, 160);
    --color-neutral: rgb(255, 204, 94);
    --color-haste: rgb(89, 255, 224);
    --color-cast-hero: rgb(38, 196, 230);
    --color-cast-enemy: rgb(255, 140, 26);
    --color-el-physical: rgb(217, 224, 242);
    --color-el-fire: rgb(255, 115, 38);
    --color-el-ice: rgb(128, 217, 255);
    --color-el-lightning: rgb(255, 242, 89);
    --color-el-poison: rgb(153, 255, 77);
    --color-el-holy: rgb(255, 247, 199);
    --color-el-dark: rgb(158, 77, 242);
    --color-el-arcane: rgb(255, 115, 217);
    --color-rarity-junk: rgb(192, 192, 196);
    --color-rarity-common: rgb(236, 236, 240);
    --color-rarity-uncommon: rgb(110, 230, 120);
    --color-rarity-rare: rgb(150, 200, 255);
    --color-rarity-epic: rgb(220, 178, 255);
    --color-rarity-legendary: rgb(255, 200, 70);
    --color-gauge-full: rgb(110, 230, 120);
    --color-gauge-mid: rgb(240, 200, 70);
    --color-gauge-low: rgb(240, 80, 70);
    --type-base: 40px; /* GG-T770: the one GUI text size; the root takes type-base-N (Tokens.cs GuiType) */
    --space-4: 4px;
    --space-8: 8px;
    --space-12: 12px; /* half of the 24-px target gap: two neighbours' margins add up to POL-C3 */
    --size-target: 132px; /* POL-C2 minimum tap target (44 pt) */
    --size-icon-inline: 32px; /* docs/ICONS.md roles: Size.IconInline, IconButton, Icon, IconNav */
    --size-icon-button: 48px;
    --size-icon: 64px;
    --size-icon-nav: 72px;
    --row-fill-max: 264px; /* two targets: the tallest a short list's row grows to fill its panel (GG-T654) */
    --kit-note-actions: 60px; /* Kit.Indent (72) less a button's 12-px margin: a row's buttons under its label */
    --space-16: 16px;
    --space-24: 24px;
    --space-32: 32px;
    --space-48: 48px;
    --space-64: 64px;
    --space-96: 96px;
    --measure-text: 720px; /* POL-A5, GG-T1899: the readable line (about 48 characters) for a long description */
    /* Corner radii (Tokens.cs Radius); tools/design_tokens.py lists each one's uses on the design-system page */
    --radius-2: 2px;
    --radius-3: 3px;
    --radius-4: 4px;
    --radius-5: 5px;
    --radius-6: 6px;
    --radius-7: 7px;
    --radius-8: 8px;
    --radius-10: 10px;
    --radius-12: 12px;
    --radius-14: 14px;
    --radius-16: 16px;
    --radius-17: 17px;
    --radius-18: 18px;
    --radius-20: 20px;
    --radius-22: 22px;
    --radius-26: 26px;
    --radius-28: 28px;
    --radius-pill: 999px;
    /* Base-theme surfaces and controls (GG-T2135): every colour a rule outside :root uses; a .theme-* block overrides by selector. */
    --color-black: rgb(0, 0, 0); /* the stage frame's fill and the screen-change fade */
    --color-clear: rgba(0, 0, 0, 0); /* no colour: a border or shadow that is switched off */
    --color-stage: rgb(12, 12, 14); /* behind everything before a theme paints it */
    --color-letterbox: rgb(6, 6, 8); /* the bars around the stage */
    --color-title: rgb(255, 244, 214); /* the warm cream of .title */
    --color-hover: rgba(255, 255, 255, 0.06); /* a menu row under the pointer (PC) */
    --color-card: rgba(255, 255, 255, 0.05); /* a card's faint lift off the window */
    --color-well: rgba(0, 0, 0, 0.38); /* the pressed-in well of a selected row, card or tile (R3) */
    --color-well-edge: rgba(0, 0, 0, 0.7); /* the dark top edge of that well */
    --color-shade: rgba(0, 0, 0, 0.6); /* Palette.Shade: the veil and a gauge's empty tube */
    --color-press: rgba(140, 170, 255, 0.34); /* a menu row while the finger is down */
    --color-card-selected: rgba(140, 170, 255, 0.22); /* a selected card */
    --color-btn: rgb(34, 58, 150); /* a button's face */
    --color-btn-lip: rgb(120, 132, 196); /* the lip a button stands on */
    --color-btn-hover: rgb(52, 84, 196);
    --color-btn-pressed: rgb(24, 40, 108);
    --color-btn-primary: rgb(196, 120, 24);
    --color-btn-primary-rim: rgb(255, 232, 170);
    --color-btn-primary-lip: rgb(150, 92, 30);
    --color-btn-primary-hover: rgb(226, 146, 40);
    --color-btn-primary-pressed: rgb(150, 88, 14);
    --color-btn-danger: rgb(150, 30, 40);
    --color-btn-danger-lip: rgb(96, 18, 26);
    --color-btn-danger-hover: rgb(178, 40, 52);
    --color-btn-danger-pressed: rgb(110, 20, 28);
    --color-badge: rgba(4, 6, 20, 0.75); /* a role badge's dark plate */
    --color-chrome: rgba(4, 8, 30, 0.85); /* the header and bottom nav */
    --color-label: rgb(170, 184, 255); /* an inactive tab, nav tab or tile label */
    --color-alert: rgb(214, 48, 64); /* a nav tab's count badge */
    --color-mana-core: rgb(220, 240, 255); /* the pale core of the title conduit */
    --color-mana-tint: rgba(107, 199, 255, 0.14); /* an active nav tab, a pressed tile */
    --color-mana-faint: rgba(107, 199, 255, 0.08); /* a hub tile at rest */
    --color-continue: rgba(20, 24, 60, 0.75); /* the title screen's Continue panel */
    --color-tab: rgb(18, 28, 84);
    --color-tab-active: rgb(40, 66, 170);
    --color-gauge-rim: rgba(255, 255, 255, 0.5);
    --color-pip-rim: rgba(255, 255, 255, 0.8);
    --color-toast: rgba(12, 18, 60, 0.96);
    --color-scrollbar: rgba(236, 238, 255, 0.6);
    --color-thumb: rgb(30, 36, 70); /* a thumbnail's plate before its art loads */
    --color-tamed: rgb(194, 235, 71); /* Palette.Tamed */
    --color-wanderer: rgb(255, 143, 204); /* Palette.Wanderer */
    --color-cb-hero: rgb(87, 181, 232); /* Palette.CbHero (Colorblind setting) */
    --color-cb-foe: rgb(245, 122, 10); /* Palette.CbFoe */
    --color-cb-boss: rgb(191, 77, 5); /* Palette.CbBoss */
    --space-16-framed: 13px; /* --space-16 less the 3-px frame of a selected card, so it does not grow (GG-T1942) */
}

/* GG-T770 (owner: "all these different font sizes make it look messy"): every GUI label draws at ONE size, --type-base.
   Tokens.cs GuiType works it out from the screen (aspect, dpi, resolution), the legibility floor and Settings -> Text size,
   and puts one type-base-N class on the UI root. Emphasis is bold, italic, colour, underline or strikethrough, never size. */
.type-base-40 { --type-base: 40px; }
.type-base-42 { --type-base: 42px; }
.type-base-44 { --type-base: 44px; }
.type-base-46 { --type-base: 46px; }
.type-base-48 { --type-base: 48px; }
.type-base-50 { --type-base: 50px; }
.type-base-52 { --type-base: 52px; }
.type-base-54 { --type-base: 54px; }
.type-base-56 { --type-base: 56px; }
.type-base-58 { --type-base: 58px; }
.type-base-60 { --type-base: 60px; }
.type-base-62 { --type-base: 62px; }
.type-base-64 { --type-base: 64px; }
.type-base-66 { --type-base: 66px; }
.type-base-68 { --type-base: 68px; }
.type-base-70 { --type-base: 70px; }
.type-base-72 { --type-base: 72px; }

/* Semantic type classes (POL-A1): all one size (GG-T770); a heading stands out by weight (the Heavy font role, applied in
   Ui.AddClasses) and colour, not size. */
.t-caption { font-size: var(--type-base); }
.t-body { font-size: var(--type-base); }
.t-h3 { font-size: var(--type-base); }
.t-h2 { font-size: var(--type-base); }
.t-h1 { font-size: var(--type-base); }
.t-display { font-size: var(--type-base); }

.stage {
    position: absolute;
    width: 1170px;
    height: 2532px;
    overflow: hidden;
    background-color: var(--color-stage);
    color: var(--color-text);
    font-size: var(--type-base);
}

.letterbox { background-color: var(--color-letterbox); }
/* Outline around the stage when the device is wider/taller than any supported phone (tablets): the bars read
   as a deliberate bezel around one big game window, in the same white rounded frame every window uses. */
.stage-frame {
    position: absolute;
    border-width: 5px;
    border-color: var(--color-frame);
    border-radius: var(--radius-22);
    background-color: var(--color-black);
}

.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.hidden { display: none; }

/* ── Windows ─────────────────────────────────────────────────────────────── */
.window {
    border-width: 5px;
    border-color: var(--color-frame);
    border-radius: var(--radius-18);
    padding: var(--space-16) var(--space-24); /* Kit.PadY / Kit.PadX (GG-T454) */
    margin: var(--space-8);
    background-size: 100% 100%;
    flex-shrink: 0;
}
/* A window holding a scrolling list (Ui.List): fills the space left over and scrolls instead of squashing the
   tabs and footers around it when its content runs long. */
.window--scroller { flex-shrink: 1; flex-basis: 0; min-height: 160px; }
.window--plain { background-color: var(--color-panel); }
.window-title {
    font-size: var(--type-base);
    color: var(--color-white);
    margin-bottom: var(--space-8);
}
.window-sub { font-size: var(--type-base); color: var(--color-sub); }

/* ── Text ────────────────────────────────────────────────────────────────── */
.title { font-size: var(--type-base); color: var(--color-title); -unity-text-align: middle-center; }
.h1 { font-size: var(--type-base); color: var(--color-white); }
.h2 { font-size: var(--type-base); color: var(--color-white); }
.small { font-size: var(--type-base); }
.tiny { font-size: var(--type-base); }
.dim { color: var(--color-dim); }
.gold { color: var(--color-gold); }
.good { color: var(--color-good); }
.bad { color: var(--color-bad); }
.warn { color: var(--color-warn); }
.shadow { text-shadow: 3px 3px 0 var(--color-text-drop); }
.num { -unity-text-align: middle-right; }

/* ── Text depth (GG-T385) ────────────────────────────────────────────────────
   Outline and text-shadow are inherited, so the body step on .stage reaches every label; headings step up, small
   text steps down (a thick outline closes the counters of a 24-30 px glyph). Dark text on a light chip (.text-ink,
   .pip) has none. A label sized inline in code takes .depth-lg / .depth-sm / .depth-none instead of inline values. */
.stage, .depth-md {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-text-edge);
    text-shadow: 3px 3px 0 var(--color-text-drop);
}
.title, .h1, .h2, .window-title, .header-title, .header-gold, .t-h3, .t-h2, .t-h1, .t-display, .depth-lg {
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--color-text-edge);
    text-shadow: 4px 4px 0 var(--color-text-drop);
}
.title, .t-display { text-shadow: 6px 6px 0 var(--color-text-drop); }
.small, .tiny, .t-caption, .role-badge, .depth-sm {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-edge);
    text-shadow: 2px 2px 0 var(--color-text-drop);
}
.pip, .text-ink, .depth-none { -unity-text-outline-width: 0; text-shadow: 0 0 0 var(--color-clear); }
.text-ink { color: var(--color-ink); }

/* ── Menu rows (cursor hand on PC only) ──────────────────────────────────── */
.menu-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--size-target);
    padding: var(--space-8) var(--space-16) var(--space-8) var(--space-8);
    border-radius: var(--radius-10);
    border-width: 3px;
    border-color: var(--color-clear);
    margin: var(--space-12) 0;
}
.menu-row:hover { background-color: var(--color-hover); }
/* GG-T1923: the selected row is pressed in, not lit: a darker inset well (white text gains contrast), a bright 3-px frame
   (non-text contrast over 3:1 on every window, so it never reads by colour alone) and a small sink. A tap on it confirms. */
.menu-row--selected { background-color: var(--color-well); border-color: var(--color-frame); border-top-color: var(--color-well-edge); translate: 0 3px; scale: 0.985 0.985; }
/* GG-T495: a locked row greys its name, value and icon, not the whole row, so the hint under it ("Joins when gear
   wears below 60%") stays readable dim text (4.9:1) instead of dim at 42% opacity (1.8:1). GG-T1864: 0.6, not 0.45, so a grey label that still informs (the shop's "More stock after ..." row) clears 4.5:1, not 3.76. */
.menu-row--disabled .menu-label, .menu-row--disabled .menu-value, .menu-row--disabled .menu-icon,
.menu-row--disabled .marquee { opacity: 0.6; }
.no-cursor .menu-cursor { display: none; }
.menu-cursor { width: 56px; height: 56px; margin-right: var(--space-8); opacity: 0; background-size: contain; flex-shrink: 0; }
.menu-row--selected > .menu-cursor { opacity: 1; }
.menu-label { flex-grow: 1; font-size: var(--type-base); flex-shrink: 1; min-width: 0; white-space: normal; }
/* A long value (a locked station's "Opens after …" hint) wraps rather than clipping or squeezing the label. */
.menu-value { font-size: var(--type-base); -unity-text-align: middle-right; margin-left: var(--space-16); flex-shrink: 1; white-space: normal; }
/* GG-T760: the Equip slot list's shorter rows; the tap target stays above 88px. Text keeps the one GUI size (GG-T770). */
.menu-row--compact { min-height: var(--size-target); margin: var(--space-12) 0; padding-top: var(--space-4); padding-bottom: var(--space-4); }
.menu-row--compact .menu-icon { width: var(--size-icon-button); height: var(--size-icon-button); margin-right: var(--space-12); }
.menu-row--compact .menu-cursor { width: 44px; height: 44px; }
.menu-icon { width: var(--size-icon); height: var(--size-icon); margin-right: var(--space-16); background-size: contain; }
/* A set icon in text (RowIcon.Line / Prefix, docs/ICONS.md): inline size, then its label, which wraps and is never cut. */
.icon-inline { width: var(--size-icon-inline); height: var(--size-icon-inline); flex-shrink: 0; margin-right: var(--space-8); background-size: contain; }
.icon-inline--value { margin-left: var(--space-16); }
.icon-line { flex-direction: row; align-items: center; }
.icon-line > Label { flex-grow: 1; flex-shrink: 1; white-space: normal; }

/* ── Buttons ─────────────────────────────────────────────────────────────── */
/* Every button stands on a darker lip (the thick bottom border). Pressing sinks it onto the lip. */
.btn {
    min-height: var(--size-target);
    min-width: var(--size-target);
    padding: 0 var(--space-48);
    margin: var(--space-12);
    border-width: 4px;
    border-bottom-width: 12px;
    border-radius: var(--radius-16);
    border-color: var(--color-frame);
    border-bottom-color: var(--color-btn-lip);
    background-color: var(--color-btn);
    color: var(--color-white);
    font-size: var(--type-base);
    -unity-text-align: middle-center;
}
.btn:hover { background-color: var(--color-btn-hover); }
.btn--primary { background-color: var(--color-btn-primary); border-color: var(--color-btn-primary-rim); border-bottom-color: var(--color-btn-primary-lip); }
.btn--primary:hover { background-color: var(--color-btn-primary-hover); }
.btn--danger { background-color: var(--color-btn-danger); border-bottom-color: var(--color-btn-danger-lip); }
.btn--danger:hover { background-color: var(--color-btn-danger-hover); }

.role-badge {
    border-width: 3px;
    border-radius: var(--radius-10);
    padding: 0 var(--space-8);
    margin: 0 var(--space-8);
    background-color: var(--color-badge);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ── Shared press feel (Ui.Pressable): sink on touch, spring back on release ── */
.pressable {
    transition-property: scale, translate, background-color, border-bottom-width, opacity;
    transition-duration: 0.06s, 0.06s, 0.08s, 0.06s, 0.1s;
    transition-timing-function: ease-out;
}
.pressable.is-pressed { scale: 0.95 0.95; translate: 0 6px; }
.pressable.is-released { transition-duration: 0.14s; transition-timing-function: ease-out-back; }
.btn.is-pressed { border-bottom-width: 4px; translate: 0 8px; background-color: var(--color-btn-pressed); }
.btn--primary.is-pressed { background-color: var(--color-btn-primary-pressed); }
.btn--danger.is-pressed { background-color: var(--color-btn-danger-pressed); }
.menu-row.is-pressed { background-color: var(--color-press); translate: 4px 2px; scale: 0.985 0.985; }
.tab.is-pressed { translate: 0 4px; scale: 0.94 0.94; }
.card-tap.is-pressed { scale: 0.94 0.94; translate: 0 6px; }
/* GG-T1942: a list card or action button selected by a first tap (Ui.ConfirmTap) is pressed in like a selected menu row;
   a second tap runs it. A card gains the inset well and 3-px frame (padding gives the border back); a button stays sunk
   onto its lip with a dark top edge. */
.card.tap--selected { background-color: var(--color-well); border-width: 3px; border-color: var(--color-frame); border-top-color: var(--color-well-edge); padding: var(--space-16-framed); translate: 0 3px; scale: 0.985 0.985; }
.btn.tap--selected { border-bottom-width: 4px; border-top-color: var(--color-well-edge); translate: 0 8px; }
.btn--small.tap--selected { border-bottom-width: 3px; translate: 0 6px; }
/* The Main Menu's mana conduit under the wordmark (GG-T1350): a lit line with a pale core. */
.title-conduit { height: 6px; margin-top: var(--space-8); border-radius: var(--radius-3); background-color: var(--color-mana); border-top-width: 2px; border-top-color: var(--color-mana-core); }
.splash-copy { margin-top: var(--space-32); }
.crawl-title { -unity-text-align: middle-center; margin-bottom: var(--space-64); }
.title-continue { align-items: flex-start; background-color: var(--color-continue); border-width: 3px; border-color: var(--color-mana); }
.slot { transition-property: scale, translate, opacity; transition-duration: 0.07s, 0.07s, 0.15s; }
.slot--targeting { scale: 1.06 1.06; }
.slot.is-pressed { scale: 0.92 0.92; translate: 0 10px; }
.btn--disabled { opacity: 0.6; }
.btn--small { min-height: var(--size-target); font-size: var(--type-base); padding: 0 var(--space-24); border-bottom-width: 9px; }
.btn--small.is-pressed { border-bottom-width: 3px; translate: 0 6px; }
.btn--icon { width: var(--size-target); padding: 0; }

/* ── Header bar ──────────────────────────────────────────────────────────── */
.header {
    flex-direction: row;
    align-items: center;
    min-height: 150px; /* Kit.HeaderHeight; grows when a title + subtitle at a larger Settings text size need more */
    padding: 0 var(--space-24);
    background-color: var(--color-chrome);
    border-bottom-width: 4px;
    border-color: var(--color-frame);
}
.header-title { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: var(--type-base); -unity-text-align: middle-left; margin-left: var(--space-16); }
/* GG-T454: a page's subtitle (station level, profile) rides in the header under its title instead of a cramped line below it. */
.header-titles { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: var(--space-16); justify-content: center; }
.header-titles > .header-title { flex-grow: 0; margin-left: 0; }
.header-sub { font-size: var(--type-base); color: var(--color-gold); -unity-text-align: middle-left; }
.header-gold { font-size: var(--type-base); color: var(--color-gold); -unity-text-align: middle-right; margin-right: var(--space-16); }
/* GG-T1361: the header's currency strip: Gold, the Shards button (opens the Shard Store), Summon Tickets. */
.header-currencies { flex-direction: row; align-items: center; flex-shrink: 0; }
.header-currencies > Button { margin-right: var(--space-24); }
.header-currencies > #header-gold { margin-right: 0; margin-left: var(--space-8); }

/* ── Bottom nav (GG-T1590, Ui.NavBar): five tabs under a hub page's body; the lit one holds the mana accent ── */
.kit-navbar {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 132px; /* Kit.NavHeight; grows by the gesture-bar inset */
    background-color: var(--color-chrome);
    border-top-width: 4px;
    border-color: var(--color-frame);
}
.kit-navtab { flex-grow: 1; flex-basis: 0; min-width: 0; height: 132px; align-items: center; justify-content: center; border-top-width: 6px; border-color: var(--color-clear); }
.kit-navtab > .menu-icon { width: var(--size-icon-nav); height: var(--size-icon-nav); margin: 0; }
.kit-navtab-label { font-size: var(--type-base); -unity-text-align: middle-center; color: var(--color-label); max-width: 100%; }
.kit-navtab-badge { position: absolute; top: var(--space-8); right: var(--space-16); }
.kit-navtab--active { border-color: var(--color-mana); background-color: var(--color-mana-tint); }
.kit-navtab--active > .kit-navtab-label { color: var(--color-mana); }
.kit-navtab--locked { opacity: 0.4; }

/* ── Camp hub tiles (GG-T1612): a wrapping grid of destination tiles, styled like the nav tabs ── */
.kit-pillar { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; padding: 0 var(--space-12); }
.kit-tile { flex-grow: 1; flex-basis: 30%; min-width: 0; height: 160px; margin: var(--space-12); align-items: center; justify-content: center; border-top-width: 6px; border-color: var(--color-clear); background-color: var(--color-mana-faint); }
.kit-tile > .menu-icon { width: 56px; height: 56px; margin: 0; }
.kit-tile-label { font-size: var(--type-base); -unity-text-align: middle-center; color: var(--color-label); max-width: 100%; }
.kit-tile-value { font-size: var(--type-base); -unity-text-align: middle-center; color: var(--color-label); max-width: 100%; white-space: normal; }
.kit-tile.is-pressed { border-color: var(--color-mana); background-color: var(--color-mana-tint); }
.kit-tile--locked { opacity: 0.4; }
/* GG-T1972: the Equip tab's slot grid, four thumbnails a row; names wrap, never cut off */
.equip-tile { flex-basis: 21%; height: auto; min-height: 160px; padding: var(--space-8) var(--space-4); justify-content: flex-start; }
.equip-tile > .kit-tile-label, .equip-tile > .kit-tile-value { white-space: normal; }
.equip-tile--selected { border-color: var(--color-mana); background-color: var(--color-well); translate: 0 3px; scale: 0.985 0.985; }

/* ── Tabs ────────────────────────────────────────────────────────────────── */
.tabs { flex-direction: row; margin: var(--space-8) var(--space-8) 0 var(--space-8); padding: 0 var(--space-12); flex-shrink: 0; } /* edge = tab margin 12 + 12 = gap 24 (POL-C8) */
.tab {
    flex-grow: 1;
    height: var(--size-target);
    margin: 0 var(--space-12);
    border-width: 4px 4px 0 4px;
    border-color: var(--color-frame);
    border-top-left-radius: var(--radius-16);
    border-top-right-radius: var(--radius-16);
    background-color: var(--color-tab);
    font-size: var(--type-base);
    -unity-text-align: middle-center;
    color: var(--color-label);
}
.tab--active { background-color: var(--color-tab-active); color: var(--color-white); }
.tab--locked { opacity: 0.4; }

/* ── Gauges ──────────────────────────────────────────────────────────────── */
.gauge { height: 20px; border-radius: var(--radius-10); background-color: var(--color-shade); border-width: 2px; border-color: var(--color-gauge-rim); overflow: hidden; }
.gauge-fill { height: 100%; border-radius: var(--radius-8); background-color: var(--color-gauge-full); }
.gauge-fill--mid { background-color: var(--color-gauge-mid); }
.gauge-fill--low { background-color: var(--color-gauge-low); }

/* ── Toast / dialog ──────────────────────────────────────────────────────── */
.toast {
    position: absolute;
    left: 120px; right: 120px; bottom: 260px;
    padding: var(--space-24) var(--space-32);
    border-radius: var(--radius-18);
    border-width: 4px;
    border-color: var(--color-frame);
    background-color: var(--color-toast);
    font-size: var(--type-base);
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}
.veil { background-color: var(--color-shade); }

/* ── Fade overlay ────────────────────────────────────────────────────────── */
.fade { background-color: var(--color-black); opacity: 0; transition-property: opacity; transition-duration: 0.22s; }
.fade--on { opacity: 1; }

/* ── Scroll views ────────────────────────────────────────────────────────── */
.list { flex-grow: 1; }
.list .unity-scroller--vertical { width: 18px; }
.list .unity-scroller__slider .unity-base-slider__dragger { background-color: var(--color-scrollbar); border-radius: var(--radius-8); }

/* ── Menu kit (GG-T454, Tokens.cs Kit) ──────────────────────────────────────
   One look for every menu: four type sizes (title 60 in the header, heading 48, body 40, caption 30), windows 24 px from
   the edge and 16 apart, 132-px rows 24 apart, notes indented to the row label. Screens use Ui's kit builders, which put
   these classes on; a screen never sets its own font size, padding or margin. */
.kit-heading { font-size: var(--type-base); color: var(--color-white); }
.kit-name { font-size: var(--type-base); color: var(--color-white); }
.kit-text { font-size: var(--type-base); white-space: normal; }
.kit-caption { font-size: var(--type-base); }
.kit-section { font-size: var(--type-base); color: var(--color-gold); margin: var(--space-16) 0 var(--space-4) 0; }
.kit-section--first { margin-top: 0; }
.kit-note { margin: 0 0 var(--space-8) 72px; } /* Kit.Indent: under the row label */
.no-cursor .kit-note { margin-left: var(--space-8); } /* GG-T1923: no cursor gutter on touch */
/* A read-only fact (Status gear, a bestiary entry, a Crucible rule): caption label in a fixed column, body value. */
.diamond-amount-box { align-self: stretch; -unity-text-align: middle-center; margin: var(--space-8) var(--space-12); padding: var(--space-8) var(--space-12); min-height: var(--size-target); background-color: var(--color-ink); border-width: 3px; border-color: var(--color-frame); border-radius: var(--radius-12); }
/* Shared count stepper (GG-T1880): boxed value at least a column wide, growing with Text size (GG-T495). */
.stepper-value { min-width: 70px; flex-shrink: 0; -unity-text-align: middle-center; padding: var(--space-4) var(--space-8); margin: 0 var(--space-4); background-color: var(--color-ink); border-width: 3px; border-color: var(--color-frame); border-radius: var(--radius-12); }
.stepper-btn { padding: 0 var(--space-8); }
.diamond-steps { flex-wrap: nowrap; padding: 0; }
.diamond-step { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 0 var(--space-4); }
.kit-field { flex-direction: row; align-items: center; margin: var(--space-4) 0; }
.kit-field__label { width: 220px; flex-shrink: 0; font-size: var(--type-base); color: var(--color-dim); }
.kit-field__value { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: var(--type-base); white-space: normal; }
.kit-empty { font-size: var(--type-base); color: var(--color-dim); white-space: normal; -unity-text-align: middle-center; padding: var(--space-24); }
/* A list card's portrait and buttons line up with its first line, however tall its text runs. */
.card.kit-card { align-items: flex-start; }
.kit-heading, .kit-name { -unity-text-outline-width: 3px; -unity-text-outline-color: var(--color-text-edge); text-shadow: 4px 4px 0 var(--color-text-drop); }
.kit-caption, .kit-section, .kit-field__label { -unity-text-outline-width: 1px; -unity-text-outline-color: var(--color-text-edge); text-shadow: 2px 2px 0 var(--color-text-drop); }
/* A window that takes the column's leftover height and scrolls (lists); two of them split it evenly. */
.window--fill { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 160px; }
/* A detail pane: as tall as what it shows, at most Kit.DetailMaxPct of the column, then it scrolls inside itself. */
.window--detail { flex-shrink: 1; min-height: 0; max-height: 45%; }
.window--detail > .list { flex-grow: 0; flex-shrink: 1; }
/* Under tabs the window sits flush on the strip (Ui.Window drops its top margin). */
.window--tabbed { margin-top: 0; padding-top: var(--space-24); } /* GG-T656: a first control (Respec) clears the tab above it by 24 + border, not 16 + 5 = 21 (POL-C3) */
/* The action bar at the foot of a screen: what it costs or does on the left, the buttons on the right. */
.kit-footer { flex-direction: row; align-items: center; }
.kit-footer > .btn { margin-top: 0; margin-bottom: 0; }
.kit-footer--end { justify-content: flex-end; }
.kit-gate { margin-top: var(--space-16); }
.icon-gap { margin-right: var(--space-16); }
.tab-icon { margin-right: var(--space-8); }
.enter-mark { margin-left: var(--space-16); }
.target-gap { margin: var(--space-12); }
/* GG-T2020: a mercenary is one 132-px row (thumbnail, name and role, a short line); the hire lengths are rows in its sheet. */
.card.merc-row { align-items: center; min-height: var(--size-target); padding-top: var(--space-8); padding-bottom: var(--space-8); }
.merc-role { margin-left: var(--space-16); }
.merc-terms { margin-top: var(--space-12); }
.merc-tag { margin-left: var(--space-8); }
/* A row of buttons inside a window or card (hire terms, use-on-hero): they wrap, 24 px apart. */
.kit-actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin: var(--space-4) 0 0 0; padding: 0 var(--space-12); } /* row padding + each button's 12-px margin: edge = gap = 24 from the text column (GG-T662) */
.kit-actions.kit-note { margin-left: var(--kit-note-actions); padding-left: 0; }
.no-cursor .kit-actions.kit-note { margin-left: 0; }
/* GG-T654: a ListPanel's content is at least its viewport tall (Ui.FillViewport sets it) and its rows share the spare
   height, each at most two targets tall. Descendant, not child: Unity's ScrollView wraps the viewport in a
   content-and-vertical-scroll container, so a `> viewport` selector never matched. Cards don't grow: a portrait card
   (a Mercenary's quote, perk and hire terms) is often taller than --row-fill-max, and capping it clipped its content
   into the next card; the list's spacing (Ui.FillViewport) fills the panel instead. */
.list--fill .unity-scroll-view__content-container > .pressable,
.list--fill .unity-scroll-view__content-container > .menu-row { flex-grow: 1; max-height: var(--row-fill-max); }
/* An empty list's message takes the spare height and sits centred in it, so an empty board reads as a deliberate
   message rather than a line over a dead band (GG-T654: Bounties/Quests on a save with none). */
.list--fill .unity-scroll-view__content-container > .kit-empty { flex-grow: 1; }
/* GG-T1883: a list with nothing in it (Ui.EmptyState) is a compact window as tall as its message and next action. */
.window--empty { flex-grow: 0; flex-shrink: 0; }
.window--empty > .list { flex-grow: 0; }
.kit-empty-state { padding: var(--space-8) 0; }
.kit-empty-state__line { flex-direction: row; align-items: center; padding: 0 var(--space-12); }
.kit-empty-state__line > .kit-text { flex-grow: 1; flex-shrink: 1; }
/* GG-T2048: the kit's chip, badge, segmented control, progress bar and sheet (DESIGN_SYSTEM §3, §4). A chip or segment
   that is selected shows pressed in (R3): the dark well, a dark top edge, sunk. */
.kit-badge { min-width: 44px; padding: 0 var(--space-8); border-radius: var(--radius-22); background-color: var(--color-alert); color: var(--color-white); font-size: var(--type-base); -unity-text-align: middle-center; }
.kit-chip { flex-direction: row; align-items: center; align-self: flex-start; padding: var(--space-4) var(--space-16); margin: var(--space-4); border-radius: var(--radius-22); border-width: 2px; border-color: var(--color-frame); background-color: var(--color-badge); }
.kit-chip__label { font-size: var(--type-base); white-space: nowrap; }
.kit-chip--tap { min-height: var(--size-target); margin: var(--space-12); padding: 0 var(--space-24); }
.kit-chip--tap.is-pressed { scale: 0.95 0.95; translate: 0 6px; background-color: var(--color-press); }
.kit-chip--selected { background-color: var(--color-well); border-width: 3px; border-top-color: var(--color-well-edge); translate: 0 3px; scale: 0.985 0.985; }
.kit-segmented { flex-direction: row; flex-wrap: nowrap; align-items: stretch; padding: 0 var(--space-12); }
.kit-segment { flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding: 0 var(--space-16); white-space: normal; }
.kit-segment--selected { border-bottom-width: 3px; border-top-color: var(--color-well-edge); translate: 0 6px; background-color: var(--color-btn-pressed); }
.kit-progress { flex-direction: row; align-items: center; }
.kit-progress__gauge { flex-grow: 1; }
.kit-progress__label { margin-left: var(--space-16); }

/* ── Portrait card ───────────────────────────────────────────────────────── */
.card {
    flex-direction: row;
    align-items: center;
    padding: var(--space-16);
    margin: var(--space-12) 0; /* the same 24-px pitch as menu rows (GG-T454) */
    flex-shrink: 0; /* a tall card (a Mercenary's quote, perk and terms) must never be squeezed into the next one (GG-T656) */
    border-radius: var(--radius-14);
    background-color: var(--color-card);
}
/* A list of few cards (Respec) shares the panel height between them instead of spreading gaps (GG-T1182). */
.list--fill .unity-scroll-view__content-container > .card--fill { flex-grow: 1; }
.card--selected { background-color: var(--color-card-selected); }
.thumb {
    width: 150px; height: 150px;
    border-radius: var(--radius-16);
    border-width: 4px;
    border-color: var(--color-frame);
    background-color: var(--color-thumb);
    background-size: cover;
    margin-right: var(--space-24);
}

/* ── Battle unit frame — the same frame as .thumb, so battle and menus share one look ── */
.unit-frame {
    border-radius: var(--radius-16);
    border-width: 4px;
    border-color: var(--color-frame);
    overflow: hidden;
}
.unit-keyline { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-width: 4px; border-radius: var(--radius-12); }
.unit-keyline--hero { border-color: var(--color-hero); }
.unit-keyline--foe { border-color: var(--color-enemy); }
.unit-keyline--boss { border-color: var(--color-boss); }
.unit-keyline--guest { border-color: var(--color-guest); }
.unit-keyline--neutral { border-color: var(--color-neutral); }
.unit-keyline--tamed { border-color: var(--color-tamed); } /* Palette.Tamed: a tamed/domesticated monster (GG-T303) */
.unit-keyline--wanderer { border-color: var(--color-wanderer); } /* Palette.Wanderer: a wandering hero earning trust (GG-T342) */
/* GG-T525 Colorblind palette (root class set by GameApp.ApplySettings): sides as one blue/orange pair, Palette.CbHero/CbFoe/CbBoss. */
.colorblind .unit-keyline--hero { border-color: var(--color-cb-hero); }
.colorblind .unit-keyline--foe { border-color: var(--color-cb-foe); }
.colorblind .unit-keyline--boss { border-color: var(--color-cb-boss); }

/* ── Orb pips (generic mana) ──────────────────────────────────────────── */
.pip { width: 34px; height: 34px; border-radius: var(--radius-17); margin: 0 var(--space-4); border-width: 2px; border-color: var(--color-pip-rim); font-size: var(--type-base); -unity-text-align: middle-center; color: var(--color-ink); }
.pip--mana { background-color: var(--color-mana); }

/* ── Rarity colors ───────────────────────────────────────────────────────── */
.rarity-Junk { color: var(--color-rarity-junk); }
.rarity-Common { color: var(--color-rarity-common); }
.rarity-Uncommon { color: var(--color-rarity-uncommon); }
.rarity-Rare { color: var(--color-rarity-rare); }
.rarity-Epic { color: var(--color-rarity-epic); }
.rarity-Legendary { color: var(--color-rarity-legendary); }

/* ══ Menu themes (GG-T185) ══════════════════════════════════════════════════
   Ui.ApplyMenuTheme puts the active theme's class (Art.MenuTheme.UssClass) on the UI root, so each theme is one
   block of rules scoped under it, switched live with no rebuild. The window body is the generated gradient
   (Art.Window); these rules restyle the frame, tabs, buttons and the few fixed-color surfaces. Rules here must
   come after the base rules (equal specificity: the later one wins), and a theme that recolors .btn re-declares
   .btn--primary/.btn--danger and the :hover/.is-pressed states, which its .btn rule would otherwise outrank.
   GG-T407: themes are data (Resources/UI/themes.json + the player's own from Settings → Windows); a theme's frame.style
   picks one of these blocks (classic = none), its optional frame colours recolour the window border inline, and its
   texture is a .window-tex layer inside each window. A new frame style = one block like this + its name in
   WindowThemeCatalog.FrameStyles. */

/* ── Chrono (default, GG-T385): owner 2026-11-16, "use a Chrono Trigger gray instead of FF blue gradient". A neutral
   medium-to-dark gray window (Art "Chrono", no blue cast) in a light bevelled frame: lit top/left edge, shaded
   bottom/right. Every fixed-color surface (header, tabs, buttons, toast, cards) is a gray from the same ramp. ── */
.theme-chrono .stage { background-color: rgb(14, 14, 16); }
.theme-chrono .letterbox { background-color: rgb(6, 6, 8); }
.theme-chrono .stage-frame { border-color: rgb(200, 200, 204); }
.theme-chrono .window {
    border-width: 6px;
    border-radius: var(--radius-10);
    border-top-color: rgb(242, 242, 244);
    border-left-color: rgb(222, 222, 226);
    border-right-color: rgb(132, 132, 138);
    border-bottom-color: rgb(102, 102, 108);
}
.theme-chrono .window--plain { background-color: rgba(58, 58, 62, 0.95); }
.theme-chrono .menu-row:hover { background-color: rgba(255, 255, 255, 0.07); }
.theme-chrono .menu-row.is-pressed { background-color: rgba(255, 255, 255, 0.26); }
.theme-chrono .card { background-color: rgba(255, 255, 255, 0.06); }
.theme-chrono .card--selected { background-color: rgba(255, 255, 255, 0.16); }
.theme-chrono .thumb { background-color: rgb(52, 52, 56); }
.theme-chrono .role-badge { background-color: rgba(12, 12, 14, 0.8); }

.theme-chrono .header {
    background-color: rgba(40, 40, 44, 0.94);
    border-color: rgb(222, 222, 226);
}
.theme-chrono .toast {
    background-color: rgba(62, 62, 66, 0.97);
    border-top-color: rgb(242, 242, 244);
    border-left-color: rgb(222, 222, 226);
    border-right-color: rgb(132, 132, 138);
    border-bottom-color: rgb(102, 102, 108);
}

.theme-chrono .tab {
    border-top-left-radius: var(--radius-8);
    border-top-right-radius: var(--radius-8);
    border-top-color: rgb(242, 242, 244);
    border-left-color: rgb(222, 222, 226);
    border-right-color: rgb(132, 132, 138);
    background-color: rgb(60, 60, 64);
    color: rgb(196, 196, 202);
}
.theme-chrono .tab--active { background-color: rgb(116, 116, 120); color: rgb(255, 255, 255); }

.theme-chrono .btn {
    border-radius: var(--radius-10);
    border-top-color: rgb(242, 242, 244);
    border-left-color: rgb(222, 222, 226);
    border-right-color: rgb(132, 132, 138);
    border-bottom-color: rgb(52, 52, 56);
    background-color: rgb(98, 98, 102);
    color: rgb(255, 255, 255);
}
.theme-chrono .btn:hover { background-color: rgb(116, 116, 120); }
.theme-chrono .btn.is-pressed { background-color: rgb(74, 74, 78); }
.theme-chrono .btn--primary { background-color: rgb(196, 120, 24); border-top-color: rgb(255, 232, 170); border-left-color: rgb(255, 232, 170); border-right-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.theme-chrono .btn--primary:hover { background-color: rgb(226, 146, 40); }
.theme-chrono .btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.theme-chrono .btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.theme-chrono .btn--danger:hover { background-color: rgb(178, 40, 52); }
.theme-chrono .btn--danger.is-pressed { background-color: rgb(110, 20, 28); }

/* ── Granite (default, GG-T404): owner 2026-11-17, "split the difference and get a gray/blue Final Fantasy/Chrono
   Trigger hybrid theme ... its own identity but also harken back". The Chrono frame and ramp cooled to a steel slate (GG-T407,
   owner: the first blue-gray "made purple"; every neutral here has red lowest and green near blue, hue 205, low
   saturation), over the themes.json "Granite" gradient with its soft granite mottle. Primary (orange) and danger (red)
   unchanged. ── */
.theme-granite .stage { background-color: rgb(22, 24, 26); }
.theme-granite .letterbox { background-color: rgb(15, 16, 17); }
.theme-granite .stage-frame { border-color: rgb(195, 214, 227); }
.theme-granite .window {
    border-width: 6px;
    border-radius: var(--radius-10);
    border-top-color: rgb(219, 240, 255);
    border-left-color: rgb(216, 236, 251);
    border-right-color: rgb(133, 146, 155);
    border-bottom-color: rgb(105, 115, 122);
}
.theme-granite .window--plain { background-color: rgba(64, 70, 74, 0.95); }
.theme-granite .menu-row:hover { background-color: rgba(219, 240, 255, 0.07); }
.theme-granite .menu-row.is-pressed { background-color: rgba(219, 240, 255, 0.26); }
.theme-granite .card { background-color: rgba(219, 240, 255, 0.06); }
.theme-granite .card--selected { background-color: rgba(219, 240, 255, 0.16); }
.theme-granite .thumb { background-color: rgb(58, 64, 68); }
.theme-granite .role-badge { background-color: rgba(21, 23, 24, 0.8); }

.theme-granite .header {
    background-color: rgba(47, 52, 55, 0.94);
    border-color: rgb(216, 236, 251);
}
.theme-granite .toast {
    background-color: rgba(67, 73, 78, 0.97);
    border-top-color: rgb(219, 240, 255);
    border-left-color: rgb(216, 236, 251);
    border-right-color: rgb(133, 146, 155);
    border-bottom-color: rgb(105, 115, 122);
}

.theme-granite .tab {
    border-top-left-radius: var(--radius-8);
    border-top-right-radius: var(--radius-8);
    border-top-color: rgb(219, 240, 255);
    border-left-color: rgb(216, 236, 251);
    border-right-color: rgb(133, 146, 155);
    background-color: rgb(65, 72, 76);
    color: rgb(193, 211, 224);
}
.theme-granite .tab--active { background-color: rgb(118, 129, 137); color: rgb(219, 240, 255); }

.theme-granite .btn {
    border-radius: var(--radius-10);
    border-top-color: rgb(219, 240, 255);
    border-left-color: rgb(216, 236, 251);
    border-right-color: rgb(133, 146, 155);
    border-bottom-color: rgb(58, 64, 68);
    background-color: rgb(101, 110, 117);
    color: rgb(219, 240, 255);
}
.theme-granite .btn:hover { background-color: rgb(118, 129, 137); }
.theme-granite .btn.is-pressed { background-color: rgb(78, 86, 91); }
.theme-granite .btn--primary { background-color: rgb(196, 120, 24); border-top-color: rgb(255, 232, 170); border-left-color: rgb(255, 232, 170); border-right-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.theme-granite .btn--primary:hover { background-color: rgb(226, 146, 40); }
.theme-granite .btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.theme-granite .btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.theme-granite .btn--danger:hover { background-color: rgb(178, 40, 52); }
.theme-granite .btn--danger.is-pressed { background-color: rgb(110, 20, 28); }

/* ── Slate: Chrono Trigger's default window — gray-blue gradient, light bevel frame, white text ── */
.theme-slate .window {
    border-width: 6px;
    border-radius: var(--radius-10);
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(104, 110, 136);
}
.theme-slate .window--plain { background-color: rgba(56, 62, 90, 0.94); }
.theme-slate .window-title { color: rgb(255, 255, 255); }
.theme-slate .window-sub { color: rgb(208, 214, 232); }
.theme-slate .dim { color: rgb(178, 186, 212); }
.theme-slate .menu-row.is-pressed { background-color: rgba(255, 255, 255, 0.26); }
.theme-slate .card--selected { background-color: rgba(255, 255, 255, 0.16); }

.theme-slate .header {
    background-color: rgba(52, 58, 86, 0.92);
    border-color: rgb(214, 218, 232);
}
.theme-slate .toast {
    background-color: rgba(64, 70, 102, 0.97);
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(104, 110, 136);
}

.theme-slate .tab {
    border-radius: 0;
    border-top-left-radius: var(--radius-8);
    border-top-right-radius: var(--radius-8);
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    background-color: rgb(62, 68, 98);
    color: rgb(190, 198, 222);
}
.theme-slate .tab--active { background-color: rgb(112, 122, 154); color: rgb(255, 255, 255); }

.theme-slate .btn {
    border-radius: var(--radius-10);
    border-top-color: rgb(236, 238, 246);
    border-left-color: rgb(214, 218, 232);
    border-right-color: rgb(128, 136, 162);
    border-bottom-color: rgb(74, 80, 106);
    background-color: rgb(92, 100, 132);
    color: rgb(255, 255, 255);
}
.theme-slate .btn:hover { background-color: rgb(108, 118, 152); }
.theme-slate .btn.is-pressed { background-color: rgb(70, 76, 104); }
.theme-slate .btn--primary { background-color: rgb(196, 120, 24); border-top-color: rgb(255, 232, 170); border-left-color: rgb(255, 232, 170); border-right-color: rgb(255, 232, 170); border-bottom-color: rgb(150, 92, 30); }
.theme-slate .btn--primary:hover { background-color: rgb(226, 146, 40); }
.theme-slate .btn--primary.is-pressed { background-color: rgb(150, 88, 14); }
.theme-slate .btn--danger { background-color: rgb(150, 30, 40); border-bottom-color: rgb(96, 18, 26); }
.theme-slate .btn--danger:hover { background-color: rgb(178, 40, 52); }
.theme-slate .btn--danger.is-pressed { background-color: rgb(110, 20, 28); }

/* ── Menu theme: Dark (GG-T186; retinted 2026-11-21 to GridGame.Gallery's own CSS, owner: "we tried FF, then
   Chrono, then back to FF - none of these where right; but the colors in all these apps is better") ───────────
   Near-black surfaces (stage #15151a, window/card #1c1c22, control #26262e), a hairline border (#2c2c34, a
   lighter #3a3a44 on focusable/interactive elements), one accent (#5a8fd9, a lighter hover tint) - the Gallery's
   own CSS never defined a separate "activated" hue, so this accent is that color project-wide now. Text #e8e8ec
   / dim #999. Flat windows (Art "Dark" paints the window texture one solid #1c1c22), no white bevel frames, no
   drop-shadowed text. Ui.ApplyMenuTheme puts .theme-dark on the panel root while the theme is picked; gold /
   good / bad / rarity stay semantic. */
.theme-dark .stage { background-color: rgb(21, 21, 26); color: rgb(232, 232, 236); }
.theme-dark .letterbox { background-color: rgb(15, 15, 19); }
.theme-dark .stage-frame { border-width: 2px; border-color: rgb(44, 44, 52); border-radius: var(--radius-12); background-color: rgb(21, 21, 26); }

.theme-dark .window { border-width: 2px; border-radius: var(--radius-10); border-color: rgb(44, 44, 52); }
.theme-dark .window--plain { background-color: rgba(28, 28, 34, 0.97); }
.theme-dark .window-title { color: rgb(232, 232, 236); }
.theme-dark .window-sub { color: rgb(153, 153, 153); }
.theme-dark .title { color: rgb(232, 232, 236); }
.theme-dark .h1, .theme-dark .h2 { color: rgb(232, 232, 236); }
.theme-dark .dim { color: rgb(153, 153, 153); }
.theme-dark .shadow { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
/* Flat docs look: a hairline outline only, no drop shadow, at every depth step (GG-T385). */
.theme-dark .stage, .theme-dark .depth-md, .theme-dark .title, .theme-dark .h1, .theme-dark .h2, .theme-dark .window-title,
.theme-dark .header-title, .theme-dark .header-gold, .theme-dark .t-h3, .theme-dark .t-h2, .theme-dark .t-h1,
.theme-dark .t-display, .theme-dark .depth-lg, .theme-dark .small, .theme-dark .tiny, .theme-dark .t-caption,
.theme-dark .role-badge, .theme-dark .depth-sm { -unity-text-outline-width: 1px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.theme-dark .menu-row { border-radius: var(--radius-6); }
.theme-dark .menu-row:hover { background-color: rgba(255, 255, 255, 0.04); }
.theme-dark .menu-row.is-pressed { background-color: rgba(90, 143, 217, 0.26); }

/* Buttons keep a thin dark lip so the shared press feel still has something to sink onto. */
.theme-dark .btn {
    border-width: 2px;
    border-bottom-width: 7px;
    border-radius: var(--radius-8);
    border-color: rgb(44, 44, 52);
    border-bottom-color: rgb(10, 10, 13);
    background-color: rgb(38, 38, 46);
    color: rgb(232, 232, 236);
}
.theme-dark .btn:hover { background-color: rgb(46, 46, 56); border-color: rgb(90, 143, 217); border-bottom-color: rgb(10, 10, 13); }
.theme-dark .btn--primary { background-color: rgb(90, 143, 217); border-color: rgb(90, 143, 217); border-bottom-color: rgb(58, 94, 150); color: rgb(21, 21, 26); }
.theme-dark .btn--primary:hover { background-color: rgb(124, 166, 227); border-color: rgb(124, 166, 227); border-bottom-color: rgb(58, 94, 150); }
.theme-dark .btn--danger { background-color: rgb(58, 24, 30); border-color: rgb(110, 42, 52); border-bottom-color: rgb(30, 10, 14); color: rgb(255, 160, 160); }
.theme-dark .btn--danger:hover { background-color: rgb(78, 30, 38); border-color: rgb(140, 52, 64); border-bottom-color: rgb(30, 10, 14); }
.theme-dark .btn.is-pressed { border-bottom-width: 2px; translate: 0 5px; background-color: rgb(28, 28, 34); }
.theme-dark .btn--primary.is-pressed { background-color: rgb(70, 115, 180); }
.theme-dark .btn--danger.is-pressed { background-color: rgb(44, 18, 22); }
.theme-dark .btn--small { border-bottom-width: 5px; }
.theme-dark .btn--small.is-pressed { border-bottom-width: 2px; translate: 0 3px; }

.theme-dark .role-badge { background-color: rgb(21, 21, 26); border-width: 2px; border-radius: var(--radius-6); }

.theme-dark .header { background-color: rgba(21, 21, 26, 0.94); border-bottom-width: 2px; border-color: rgb(44, 44, 52); }
.theme-dark .header-title { color: rgb(232, 232, 236); }

.theme-dark .tab {
    border-width: 2px 2px 0 2px;
    border-color: rgb(44, 44, 52);
    border-top-left-radius: var(--radius-8);
    border-top-right-radius: var(--radius-8);
    background-color: rgb(28, 28, 34);
    color: rgb(153, 153, 153);
}
.theme-dark .tab--active { background-color: rgb(38, 38, 46); color: rgb(232, 232, 236); border-top-color: rgb(90, 143, 217); border-top-width: 4px; }

.theme-dark .gauge { background-color: rgb(21, 21, 26); border-color: rgb(44, 44, 52); }

.theme-dark .toast { background-color: rgba(28, 28, 34, 0.97); border-width: 2px; border-radius: var(--radius-10); border-color: rgb(44, 44, 52); color: rgb(232, 232, 236); }
.theme-dark .veil { background-color: rgba(5, 6, 8, 0.72); }

.theme-dark .list .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(153, 153, 153, 0.45); border-radius: var(--radius-6); }

.theme-dark .card { background-color: rgba(255, 255, 255, 0.03); border-radius: var(--radius-8); }
.theme-dark .card--selected { background-color: rgba(90, 143, 217, 0.14); }
.theme-dark .thumb { border-width: 2px; border-radius: var(--radius-8); border-color: rgb(44, 44, 52); background-color: rgb(38, 38, 46); }

/* ── Menu theme: Manapunk (GG-T678, BIBLE §11.5; owner 2026-11-22: "not steampunk but manapunk... like a high tech
   facility but also old and abandoned"). Between Dark and Classic: Dark's flat, quiet surfaces, tinted toward the
   Manalith's indigo. Smoked-glass panes (themes.json gradient #22203A→#100F1C, a faint soft-light wear), framed by
   thin pewter rails (#60646F, darker #34363F underneath), with contained mana as the one accent: the window's top edge
   is a lit conduit (#7590C8, sampled from the Manalith art), and so is the active tab and the primary button. Sizes
   and radii are exactly .theme-dark's, so layout and the POL-C1 lint are untouched; only colour changes. Text #E6E6EE,
   dim #A4A3BC (both above 6:1 on every pane). gold / good / bad / rarity stay semantic. */
.theme-manapunk .stage { background-color: rgb(12, 12, 22); color: rgb(230, 230, 238); }
.theme-manapunk .letterbox { background-color: rgb(7, 7, 14); }
.theme-manapunk .stage-frame { border-width: 2px; border-color: rgb(96, 100, 111); border-radius: var(--radius-12); background-color: rgb(12, 12, 22); }

.theme-manapunk .window { border-width: 2px; border-radius: var(--radius-10); border-color: rgb(96, 100, 111); border-bottom-color: rgb(52, 54, 63); border-top-color: rgb(117, 144, 200); }
.theme-manapunk .window--plain { background-color: rgba(26, 25, 48, 0.94); }
.theme-manapunk .window-title { color: rgb(230, 230, 238); }
.theme-manapunk .window-sub { color: rgb(164, 163, 188); }
.theme-manapunk .title { color: rgb(230, 230, 238); }
.theme-manapunk .h1, .theme-manapunk .h2 { color: rgb(230, 230, 238); }
.theme-manapunk .dim { color: rgb(164, 163, 188); }
.theme-manapunk .shadow { text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.theme-manapunk .stage, .theme-manapunk .depth-md, .theme-manapunk .title, .theme-manapunk .h1, .theme-manapunk .h2, .theme-manapunk .window-title,
.theme-manapunk .header-title, .theme-manapunk .header-gold, .theme-manapunk .t-h3, .theme-manapunk .t-h2, .theme-manapunk .t-h1,
.theme-manapunk .t-display, .theme-manapunk .depth-lg, .theme-manapunk .small, .theme-manapunk .tiny, .theme-manapunk .t-caption,
.theme-manapunk .role-badge, .theme-manapunk .depth-sm { -unity-text-outline-width: 1px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

.theme-manapunk .menu-row { border-radius: var(--radius-6); }
.theme-manapunk .menu-row:hover { background-color: rgba(164, 163, 188, 0.06); }
.theme-manapunk .menu-row.is-pressed { background-color: rgba(117, 144, 200, 0.28); }

/* Buttons: a capsule with a fine pewter rim on a dark lip; the primary holds contained mana. */
.theme-manapunk .btn {
    border-width: 2px;
    border-bottom-width: 7px;
    border-radius: var(--radius-8);
    border-color: rgb(96, 100, 111);
    border-bottom-color: rgb(14, 14, 24);
    background-color: rgb(42, 40, 64);
    color: rgb(230, 230, 238);
}
.theme-manapunk .btn:hover { background-color: rgb(52, 50, 78); border-color: rgb(117, 144, 200); border-bottom-color: rgb(14, 14, 24); }
/* GG-T678: the primary action is a charged mana cell: a bright lit top edge over the blue body. */
.theme-manapunk .btn--primary { background-color: rgb(117, 144, 200); border-color: rgb(172, 165, 211); border-top-color: rgb(214, 210, 240); border-bottom-color: rgb(65, 56, 111); color: rgb(12, 12, 22); }
.theme-manapunk .btn--primary:hover { background-color: rgb(140, 164, 214); border-color: rgb(200, 196, 230); border-bottom-color: rgb(65, 56, 111); }
.theme-manapunk .btn--danger { background-color: rgb(60, 26, 38); border-color: rgb(150, 54, 89); border-bottom-color: rgb(30, 12, 18); color: rgb(255, 176, 184); }
.theme-manapunk .btn--danger:hover { background-color: rgb(80, 32, 48); border-color: rgb(193, 112, 140); border-bottom-color: rgb(30, 12, 18); }
.theme-manapunk .btn.is-pressed { border-bottom-width: 2px; translate: 0 5px; background-color: rgb(30, 29, 48); }
.theme-manapunk .btn--primary.is-pressed { background-color: rgb(84, 99, 170); }
.theme-manapunk .btn--danger.is-pressed { background-color: rgb(44, 18, 28); }
.theme-manapunk .btn--small { border-bottom-width: 5px; }
.theme-manapunk .btn--small.is-pressed { border-bottom-width: 2px; translate: 0 3px; }

.theme-manapunk .role-badge { background-color: rgb(12, 12, 22); border-width: 2px; border-radius: var(--radius-6); }

.theme-manapunk .header { background-color: rgba(16, 15, 28, 0.94); border-bottom-width: 2px; border-color: rgb(117, 144, 200); }
.theme-manapunk .header-title { color: rgb(230, 230, 238); }
.theme-manapunk .kit-navbar { background-color: rgba(16, 15, 28, 0.94); border-top-width: 2px; border-color: rgb(96, 100, 111); }
.theme-manapunk .kit-navtab-label { color: rgb(164, 163, 188); }
.theme-manapunk .kit-navtab--active { border-color: rgb(117, 144, 200); border-top-width: 4px; background-color: rgba(117, 144, 200, 0.16); }
.theme-manapunk .kit-navtab--active > .kit-navtab-label { color: rgb(230, 230, 238); }
.theme-manapunk .kit-navtab.is-pressed { background-color: rgba(117, 144, 200, 0.28); }

.theme-manapunk .tab {
    border-width: 2px 2px 0 2px;
    border-color: rgb(96, 100, 111);
    border-top-left-radius: var(--radius-8);
    border-top-right-radius: var(--radius-8);
    background-color: rgb(26, 25, 48);
    color: rgb(164, 163, 188);
}
.theme-manapunk .tab--active { background-color: rgb(42, 40, 64); color: rgb(230, 230, 238); border-top-color: rgb(117, 144, 200); border-top-width: 4px; }

/* GG-T678: every meter is a glass tube in a pewter sleeve: lit pewter on top, worn dark below, near-black glass inside. */
.theme-manapunk .gauge { background-color: rgb(16, 15, 28); border-color: rgb(96, 100, 111); border-top-color: rgb(140, 144, 156); border-bottom-color: rgb(52, 54, 63); }

.theme-manapunk .toast { background-color: rgba(26, 25, 48, 0.97); border-width: 2px; border-radius: var(--radius-10); border-color: rgb(96, 100, 111); border-top-color: rgb(117, 144, 200); color: rgb(230, 230, 238); }
.theme-manapunk .veil { background-color: rgba(5, 5, 12, 0.72); }

.theme-manapunk .list .unity-scroller__slider .unity-base-slider__dragger { background-color: rgba(117, 144, 200, 0.45); border-radius: var(--radius-6); }

.theme-manapunk .card { background-color: rgba(164, 163, 188, 0.04); border-radius: var(--radius-8); }
.theme-manapunk .card--selected { background-color: rgba(117, 144, 200, 0.16); }
.theme-manapunk .thumb { border-width: 2px; border-radius: var(--radius-8); border-color: rgb(96, 100, 111); background-color: rgb(42, 40, 64); }

/* ── Quest journal hand-in card (GG-T237): slides in rather than popping ── */
.quest-turnin { transition-property: opacity, translate; transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.quest-turnin.is-hidden { opacity: 0; translate: 0 -40px; }

/* ── Battle description panel (GG-T1822, BIBLE §9.0): one window from a gutter under the ability bar to the safe bottom;
   its page scrolls inside it. Buttons in a page drop their vertical margin (the panel is short on the shortest stage)
   and keep the 24-px side gap. The Party · Lore · Log tab strip is gone. ── */
/* The mana pool (GG-T405): the "-N" ghost of an aimed spell and the dimmed count fade rather than snap. */
.mana-pool .mana-pool__ghost { transition-property: opacity; transition-duration: 0.15s; }
.mana-pool .mana-pool__count { transition-property: opacity; transition-duration: 0.15s; }
.description-panel .description-panel__window { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin: 0; padding: var(--space-8) var(--space-24); }
.description-panel .description-panel__page { flex-grow: 1; flex-shrink: 1; }
/* GG-T1907: the page starts at the window's 24-px inset (no centred dead band); rows (the confirm card's Cancel / Cast,
   the ability header) use the full width, while each line of text keeps the 720-px measure (POL-A5, GG-T1899). */
.description-panel .description-panel__page .unity-scroll-view__content-container { width: 100%; }
.description-panel .description-panel__page .unity-label { max-width: var(--measure-text); }
.description-panel .description-panel__page .glossary-text { max-width: var(--measure-text); }
.description-panel .description-panel__page .btn { margin-top: 0; margin-bottom: 0; }
