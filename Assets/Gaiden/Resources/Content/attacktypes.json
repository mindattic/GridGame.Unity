    { "Id": "slam", "Brief": "A huge body landing: a deep, low boom with a ground-shake tail (stone, timber or meat), heavier and slower than blunt.",
      "Sfx": ["battle_hit_slam_0", "battle_hit_slam_1", "battle_hit_slam_2"] },
    { "Id": "claw", "Brief": "Raking talons: a quick triple scrape-and-tear, ripping cloth and hide.",
      "Sfx": ["battle_hit_claw_0", "battle_hit_claw_1", "battle_hit_claw_2", "battle_hit_claw_3"] },
    { "Id": "bite", "Brief": "Jaws snapping shut: a wet crunch with a short snarl or hiss in front of it.",
      "Sfx": ["battle_hit_bite_0", "battle_hit_bite_1", "battle_hit_bite_2"] },
    { "Id": "sting", "Brief": "A stinger or fang-jab: a dry chitin click, a tiny needle punch and a faint venom squirt.",
      "Sfx": ["battle_hit_sting_0", "battle_hit_sting_1", "battle_hit_sting_2"] },
    { "Id": "lash", "Brief": "Whip, chain, cord, tongue or tentacle: a whistling swing ending in a sharp crack or a wet slap.",
      "Sfx": ["battle_hit_lash_0", "battle_hit_lash_1", "battle_hit_lash_2"] },
    { "Id": "projectile", "Brief": "An arrow, bolt, dart, thrown spear or round arriving: a short incoming zip and a hard thunk into the target.",
      "Sfx": ["battle_hit_projectile_0", "battle_hit_projectile_1", "battle_hit_projectile_2", "battle_hit_projectile_3"] },
    { "Id": "magic", "Brief": "A focus (orb, wand, tome, staff) striking: a bright arcane zap-pop with a shimmering tail, no physical impact.",
